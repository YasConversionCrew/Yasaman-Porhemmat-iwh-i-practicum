doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1= title
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          each prop in properties
            th= prop
      tbody
        each obj in objects
          tr
            each prop in properties
              td= obj.properties[prop]